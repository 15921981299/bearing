# Keywords Everywhere API（可选，用于 npm run export:keywords:ke 等脚本）
# 在 https://keywordseverywhere.com/ 账户设置中获取 API Key
KEYWORDS_EVERYWHERE_API_KEY=
KEYWORDS_EVERYWHERE_COUNTRY=us
KEYWORDS_EVERYWHERE_CURRENCY=USD

# 公司 LinkedIn 主页（可选，填入后自动出现在 Organization schema 与页脚）
PUBLIC_LINKEDIN_URL=

# 作者 LinkedIn（可选，填入后出现在 Person schema sameAs）
PUBLIC_AUTHOR_WEI_CHEN_LINKEDIN=
PUBLIC_AUTHOR_LISA_HUANG_LINKEDIN=
