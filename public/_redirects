# Fold legacy /standards/* paths into /certifications/ — nothing is served at /standards/.
#
# Never add a rule whose left-hand side exists under src/pages/: a match here is
# evaluated at the Cloudflare edge BEFORE static assets, so it 301s away a page that
# really was built. Local tooling cannot catch that — `astro build` succeeds and
# `check:links` scans dist/ and reports the link as intact.

/standards/* /certifications/ 301

# Crawlers — Bing especially — probe /sitemap.xml and /sitemap_index.xml before
# they trust the Sitemap: line in robots.txt. Both 404 today, which is the likely
# reason Bing Webmaster Tools keeps reporting "sitemap not found". Point them at
# the real index generated by @astrojs/sitemap. Neither path exists under
# src/pages/ nor in dist/, so this cannot shadow a page that was really built.
/sitemap.xml /sitemap-index.xml 301
/sitemap_index.xml /sitemap-index.xml 301
