---
import {
  articleReviewAuthor,
  teamMemberHref,
  type TeamMember,
} from "../data/team";

interface Props {
  /** Override the default named reviewer (e.g. a per-page author). */
  author?: TeamMember;
  /** ISO date the page was last reviewed by that person. */
  reviewedOn?: string;
  label?: string;
}

const {
  author = articleReviewAuthor,
  reviewedOn,
  label = "Technical review",
} = Astro.props;
---

{author && (
  <p class="author-byline">
    <span class="author-byline-label">{label}</span>
    <span class="author-byline-person">
      by <a href={teamMemberHref(author.slug)}>{author.name}</a>, {author.role}
    </span>
    {reviewedOn && (
      <span class="author-byline-date">Reviewed {reviewedOn}</span>
    )}
  </p>
)}

<style>
  .author-byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin: 0 0 20px;
    padding: 10px 14px;
    border: 1px solid var(--color-stroke);
    border-left: 3px solid var(--color-primary);
    border-radius: 6px;
    background: var(--color-background);
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-body-text);
  }

  .author-byline-label {
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 11px;
    color: var(--color-primary);
  }

  .author-byline-person a {
    color: var(--color-title);
    font-weight: 600;
    text-decoration: none;
  }

  .author-byline-person a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .author-byline-date {
    color: #64748b;
  }

  .author-byline-person a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
