---
import '../styles/detail-rfq-strip.css';

interface Props {
  quoteHref: string;
  title?: string;
  text?: string;
  label?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  modalContext?: string;
  modalSource?: string;
}

const {
  quoteHref,
  title = 'Quote this part type',
  text = 'Send your bearing model, dimensions, quantity, application, and destination for a practical availability check.',
  label = 'Request Bearings',
  secondaryHref,
  secondaryLabel = 'Bearing Products',
  modalContext = title,
  modalSource,
} = Astro.props;
---

<aside class="detail-rfq-strip" aria-label="Request a quotation">
  <div class="detail-rfq-copy">
    <p class="detail-rfq-title">{title}</p>
    <p class="detail-rfq-text">{text}</p>
  </div>
  <div class="detail-rfq-actions">
    <a
      href={quoteHref}
      class="detail-rfq-link detail-rfq-link--primary"
      data-rfq-modal
      data-rfq-context={modalContext}
      data-rfq-source={modalSource}
    >
      {label}
    </a>
    {secondaryHref && (
      <a href={secondaryHref} class="detail-rfq-link detail-rfq-link--secondary">{secondaryLabel}</a>
    )}
  </div>
</aside>
