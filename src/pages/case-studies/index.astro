---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import { factoryCaseStudies, factoryEvidenceSource } from '../../data/factory-evidence';
import { breadcrumbSchema, itemListSchema, site } from '../../data/site';
import '../../styles/resource-library.css';
import '../../styles/factory-evidence.css';

const pageUrl = `${site.url}/case-studies/`;
---

<BaseLayout
  title="Bearing Application Cases | Factory OEM References"
  description="Factory application cases for steel equipment bearings, combined bearings, cross roller bearings and harmonic-reducer OEM programs."
  currentPath="/case-studies"
  jsonLd={[
    breadcrumbSchema([{ name: 'Home', url: site.url }, { name: 'Case Studies', url: pageUrl }]),
    itemListSchema(factoryCaseStudies.map((study) => ({ name: study.title, url: `${pageUrl}${study.slug}/` }))),
  ]}
>
  <BreadcrumbHero
    title="Application Cases"
    trail={[{ label: 'Home', href: '/' }, { label: 'Case Studies' }]}
    variant="5"
  />

  <section class="resource-library-section factory-evidence-section">
    <div class="section-gap">
      <div class="container">
        <header class="resource-library-intro">
          <p class="resource-page-kicker">Factory application references</p>
          <h2>OEM, mast and steel-line application cases</h2>
          <p>
            These pages summarize typical application requirements handled by our Changzhou manufacturing team
            for forklift mast bearings, welded-plate assemblies, conveyors, steel equipment and cross roller OEM
            programs.
          </p>
        </header>

        <div class="factory-case-grid">
          {factoryCaseStudies.map((study, index) => (
            <article class="factory-case-card">
              <a class="factory-case-card-media" href={`/case-studies/${study.slug}/`}>
                <img
                  src={study.image}
                  alt={`${study.industry} — ${study.title}`}
                  width={study.imageWidth}
                  height={study.imageHeight}
                  loading="lazy"
                  decoding="async"
                />
                <span class="factory-case-card-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="factory-case-card-industry">{study.industry}</span>
              </a>
              <div class="factory-case-card-body">
                <h2>
                  <a href={`/case-studies/${study.slug}/`}>{study.title}</a>
                </h2>
                <p>{study.description}</p>
                <a class="factory-case-card-link" href={`/case-studies/${study.slug}/`}>
                  Review application case →
                </a>
              </div>
            </article>
          ))}
        </div>

        <aside class="factory-disclosure" aria-label="Factory disclosure">
          <strong>Plant note:</strong> {factoryEvidenceSource.disclosure}{' '}
          <a href={factoryEvidenceSource.url}>About our factory</a>.
        </aside>

        <nav class="resource-library-footer" aria-label="Related libraries">
          <a href="/products/">Bearing products</a>
          <span aria-hidden="true">·</span>
          <a href="/solutions/">Application solutions</a>
          <span aria-hidden="true">·</span>
          <a href="/about/">Factory profile</a>
          <span aria-hidden="true">·</span>
          <a href="/contact/">Request quotation</a>
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>
