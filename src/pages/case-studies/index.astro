---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import { factoryCaseStudies, factoryEvidenceSource } from '../../data/factory-evidence';
import { breadcrumbSchema, itemListSchema, site } from '../../data/site';
import '../../styles/factory-evidence.css';

const pageUrl = `${site.url}/case-studies/`;
---
<BaseLayout
  title="Bearing Application Cases | Factory OEM References"
  description="Factory application cases for steel equipment bearings, combined bearings, cross roller bearings and harmonic-reducer OEM programs."
  currentPath="/case-studies"
  jsonLd={[
    breadcrumbSchema([{name:'Home',url:site.url},{name:'Case Studies',url:pageUrl}]),
    itemListSchema(factoryCaseStudies.map(study=>({name:study.title,url:`${pageUrl}${study.slug}/`}))),
  ]}
>
  <BreadcrumbHero title="Application Cases" trail={[{label:'Home',href:'/'},{label:'Case Studies'}]} variant="5" />
  <main class="factory-evidence-page">
    <div class="container">
      <header class="factory-evidence-intro">
        <p class="factory-evidence-kicker">Factory application references</p>
        <h2>OEM, mast and steel-line application cases</h2>
        <p>These pages summarize typical application requirements handled by our Changzhou manufacturing team for forklift mast bearings, welded-plate assemblies, conveyors, steel equipment and cross roller OEM programs.</p>
      </header>
      <div class="factory-case-grid">
        {factoryCaseStudies.map(study=><article class="factory-case-card">
          <img src={study.image} alt="" width={study.imageWidth} height={study.imageHeight} loading="lazy" decoding="async" />
          <div><p>{study.industry}</p><h2><a href={`/case-studies/${study.slug}/`}>{study.title}</a></h2><p>{study.description}</p><a href={`/case-studies/${study.slug}/`}>Review application case</a></div>
        </article>)}
      </div>
      <p class="factory-disclosure"><strong>Plant note:</strong> {factoryEvidenceSource.disclosure} <a href={factoryEvidenceSource.url}>About our factory</a>.</p>
    </div>
  </main>
</BaseLayout>
