---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbHero from '../components/BreadcrumbHero.astro';
import FaqSection from '../components/FaqSection.astro';
import FunnelPageView from '../components/FunnelPageView.astro';
import { faqs } from '../data/faqs';
import { breadcrumbSchema, faqSchema, site, whatsappLinkNumber } from '../data/site';
const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---
<BaseLayout title="Industrial Bearing Inquiry | Contact" description="Request combined bearings, track rollers or custom rollers. Send the model, dimensions, drawing, quantity and delivery country for review." currentPath="/contact" hideFloatingCta jsonLd={[breadcrumbSchema([{name:'Home',url:site.url},{name:'Bearing Inquiry',url:`${site.url}/contact/`}]),faqSchema(faqs.map(f=>({question:f.question,answer:f.answer})))]}>
  <FunnelPageView stage="quote" label="contact-rfq" />
  <BreadcrumbHero title="Contact & Bearing Inquiry" trail={[{label:'Home',href:'/'},{label:'Contact'}]} variant="5" />
  <nav class="contact-resource-links fade-in" aria-label="Bearing product resources"><a href="/solutions/china-bearing-manufacturer-export/">Export RFQ guide</a><a href="/solutions/bearing-export-shipping-incoterms/">Shipping &amp; Incoterms</a><a href="/solutions/oem-custom-bearing-program/">OEM custom program</a><a href="/solutions/winkel-bearing-cross-reference/">WINKEL cross-ref</a><a href="/downloads/">Catalog downloads</a></nav>
  <section class="contact-form-section"><div class="section-gap"><div class="container"><div class="contact-form-wrapper fade-in">
    <div class="contact-leftside-block"><div class="contact-form-block"><div class="contact-form-title-block">
      <h2 class="contact-form-title">Send a Bearing Inquiry</h2><p class="contact-form-lead">Send a bearing model, dimensions, drawing, old-bearing photo or product list. Include application and operating data when the exact model is unclear.</p>
      <ul class="contact-trust-badges" aria-label="Inquiry support"><li><span class="contact-trust-check" set:html={checkIcon} />Fast inquiry response</li><li><span class="contact-trust-check" set:html={checkIcon} />Model and dimension review</li><li><span class="contact-trust-check" set:html={checkIcon} />Standard and custom bearings</li><li><span class="contact-trust-check" set:html={checkIcon} />Worldwide shipping</li></ul>
    </div><form class="contact-form" id="rfq-form" data-endpoint="https://combinedbearingsource.com/api/rfq" data-fallback-email={site.email}>
      <div class="contact-form-column"><label class="contact-field-label" for="rfq-name">Your Name *</label><input class="contact-form-input-field" type="text" id="rfq-name" name="name" autocomplete="name" required /></div>
      <div class="contact-form-column"><label class="contact-field-label" for="rfq-email">Your Email *</label><input class="contact-form-input-field" type="email" id="rfq-email" name="email" autocomplete="email" required /></div>
      <div class="contact-form-column"><label class="contact-field-label" for="rfq-phone">WhatsApp / Phone</label><input class="contact-form-input-field" type="tel" id="rfq-phone" name="phone" autocomplete="tel" /></div>
      <div class="contact-form-column"><label class="contact-field-label" for="rfq-country">Destination Country</label><input class="contact-form-input-field" type="text" id="rfq-country" name="country" autocomplete="country-name" /></div>
      <div class="contact-form-column contact-form-column--full"><label class="contact-field-label" for="rfq-message">Bearing Model / Inquiry Details *</label><textarea id="rfq-message" placeholder="Model, dimensions, quantity, application, load, speed, accuracy, sealing and destination." name="message" class="contact-form-input-field large" required></textarea></div>
      <div class="contact-form-column file-upload-column"><span class="contact-field-label" id="rfq-drawing-label">Upload Drawing / Photo / Product List</span><label class="file-upload-label" for="drawing-upload"><input type="file" id="drawing-upload" name="drawing" accept=".pdf,.xls,.xlsx,.csv,.jpg,.jpeg,.png" class="file-upload-input" /><span class="file-upload-content"><span class="file-upload-title">Choose a file (optional)</span><span class="file-upload-hint">PDF, Excel, CSV, JPG or PNG</span><span class="file-upload-filename" data-placeholder="No file selected">No file selected</span></span></label></div>
      <input type="hidden" name="source" id="rfq-source" value="Contact form" /><div class="hp-field" aria-hidden="true"><label for="rfq-website">Leave empty</label><input type="text" id="rfq-website" name="website" tabindex="-1" autocomplete="off" /></div>
      <div class="contact-form-button-block"><button type="submit" class="contact-form-button">Send Bearing Inquiry →</button><p class="contact-form-submit-note">We will ask follow-up questions if specification details are missing.</p></div><div class="form-result" aria-live="polite"></div>
    </form></div></div>
    <div class="contact-rightside-block"><div class="contact-image-block"><img src="/images/bearing-dimensional-inspection.webp" alt="Industrial bearing model and dimensional inspection" class="contact-form-image" width="1200" height="1114" loading="lazy" decoding="async" /></div><div class="contact-form-image-overlay"></div><div class="contact-image-contect-block"><div class="contact-text-contect-block"><h2 class="contact-form-title text-color-white">What Happens Next</h2><div class="process-steps"><div class="process-step"><span class="step-number">1</span><p class="contact-form-summary">We review the model, dimensions, application and quantity.</p></div><div class="process-step"><span class="step-number">2</span><p class="contact-form-summary">We confirm open specification questions and available options.</p></div><div class="process-step"><span class="step-number">3</span><p class="contact-form-summary">You receive pricing, lead time and shipping information.</p></div></div></div></div></div>
  </div></div></div></section>
  <section class="contact-info-section"><div class="section-gap bottom"><div class="container"><div class="contact-info-grid">
    <div class="contact-info-card"><h2>Email</h2><a href={`mailto:${site.email}`}>{site.email}</a></div>
    <div class="contact-info-card"><h2>WhatsApp</h2><a href={`https://wa.me/${whatsappLinkNumber(site.whatsapp)}`}>{site.whatsapp}</a></div>
    <div class="contact-info-card"><h2>Phone</h2><a href={`tel:${site.phone}`}>{site.phone}</a></div>
    <div class="contact-info-card"><h2>Manufacturing Plant</h2><p>{site.locations.plant.name}<br />{site.locations.plant.streetAddress}<br />{site.locations.plant.addressLocality}, {site.locations.plant.addressRegion} {site.locations.plant.postalCode}</p></div>
    <div class="contact-info-card"><h2>Export Office</h2><p>{site.locations.exportOffice.name}<br />{site.locations.exportOffice.streetAddress}<br />{site.locations.exportOffice.addressLocality}, China</p></div>
    <div class="contact-info-card"><h2>Export support</h2><p><a href="/solutions/china-bearing-manufacturer-export/">Factory-direct export RFQ</a><br /><a href="/resources/industrial-bearing-rfq-checklist/">RFQ checklist</a></p></div>
  </div></div></div></section>
  <FaqSection items={faqs} title="Industrial Bearing Inquiry FAQ" />
</BaseLayout>
