---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { products } from '../data/products';
import { productFaqs } from '../data/page-faqs';
import { faqSchema, itemListSchema, site } from '../data/site';
const workflowSteps=[
  {step:'01',title:'Send Bearing Details',summary:'Send the model, dimensions, quantity, application, delivery country and any drawing or marking photos.'},
  {step:'02',title:'Specification Review',summary:'We review series references, dimensions, mounting, load, speed, sealing and modification requirements.'},
  {step:'03',title:'Quotation & Confirmation',summary:'Receive the proposed specification, price, lead time, inspection scope and delivery terms.'},
  {step:'04',title:'Inspection & Shipment',summary:'The order is checked against confirmed requirements and prepared for international delivery.'},
];
---
<BaseLayout title="Industrial Bearing Manufacturer | Combined Bearings & Track Rollers" description="Industrial bearing supplier for combined bearings, track rollers, SL full-complement cylindrical roller bearings, back-up rollers, cross roller bearings and NbV profiles." currentPath="/" jsonLd={[itemListSchema(products.map(p=>({name:p.title,url:`${site.url}/products/${p.slug}/`}))),faqSchema(productFaqs.map(f=>({question:f.question,answer:f.answer})))]}>
  <section class="hero-section"><div class="container"><div class="hero-wrapper"><div class="hero-content-block"><div class="hero-subtitle-block fade-in"><img src="/images/precision-manufacturing-badge-icon.svg" alt="Precision bearing supply" class="hero-subtitle-icon" width="24" height="24"/><div class="hero-subtitle-text">{site.tagline}</div></div><div class="hero-title-block"><h1 class="hero-title fade-in">Industrial Bearing Manufacturer<br/>Standard & Custom Roller Bearings</h1></div><div class="hero-bottom-content-block"><div class="hero-summary-block"><p class="hero-summary">Combined bearings, track roller bearings, full-complement cylindrical roller bearings, back-up rollers and cross roller bearings. Send your model, dimensions, drawing, quantity and application for review.</p></div><div class="hero-button-block"><div class="hero-cta-row"><a href="/contact/?source=homepage" class="secondary-button hero"><div class="button-content-block"><div class="button-text">Request Bearings</div><div class="button-text">Request Bearings</div></div></a><a href="/products/" class="hero-secondary-cta">Bearing Products</a></div><ul class="hero-trust-row"><li>Model cross-reference</li><li>Standard & custom sizes</li><li>Worldwide shipping</li></ul></div></div></div><div class="hero-image-block"><img src="/images/industrial-bearing-hero.webp" alt="Industrial combined bearings, track rollers and roller bearings" class="hero-image" width="800" height="649"/><div class="hero-image-overlay image-overlay fade-in"></div></div></div></div></section>
  <section class="service-section"><div class="section-gap bottom"><div class="container"><div class="service-wrapper"><SectionHeading title="Industrial Bearing Products" subtitle="What We Supply"/><div class="service-bottom-block fade-in"><p class="service-bottom-text service-bottom-hint">Search by family or series, then <a href="/contact/" class="service-bottom-link">send the operating data</a> for confirmation.</p></div><div class="service-card-sticky-block fade-in">{products.slice(0,6).map(product=><div class="service-card-item-block"><a href={`/products/${product.slug}/`} class="service-card-image-block"><img src={product.image} alt={product.title} class="service-card-image" width="400" height="441" loading="lazy"/><div class="service-card-image-overlay"></div></a><div class="service-card-content-block"><div class="service-card-text-block"><a href={`/products/${product.slug}/`} class="service-title-link-block"><h2 class="service-card-title">{product.title}</h2></a><p class="service-card-summary">{product.summary}</p></div></div></div>)}</div></div></div></div></section>
  <section class="booking-steps-section"><div class="section-gap bottom"><div class="container"><div class="booking-steps-wrapper"><SectionHeading title="From Model to Delivery" subtitle="How It Works"/><div class="booking-steps-content-block fade-in"><div class="booking-steps-sticky-block">{workflowSteps.map((item,i)=><div class:list={['booking-step-card-block',`is-${i+1}`]}><div class="booking-step-content-block"><div class="booking-step-number">{item.step}</div><h3 class="booking-step-title">{item.title}</h3><p class="booking-step-summary">{item.summary}</p></div></div>)}</div></div></div></div></div></section>
</BaseLayout>


