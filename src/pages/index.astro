---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogSectionHead from '../components/CatalogSectionHead.astro';
import FaqSection from '../components/FaqSection.astro';
import { products } from '../data/products';
import { factoryEvidenceSource, factoryFacilityMedia } from '../data/factory-evidence';
import { productFaqs } from '../data/page-faqs';
import { faqSchema, itemListSchema, site } from '../data/site';
import '../styles/products-index.css';
import '../styles/home.css';

const pageUrl = `${site.url}/`;
const pageTitle = 'China Industrial Bearing Manufacturer | Factory-Direct OEM';
const pageDescription =
  'Factory-direct combined bearings, track rollers and custom industrial rollers from our Changzhou plant, with global export support.';

const workflowSteps = [
  {
    step: '01',
    title: 'Send bearing details',
    summary:
      'Send the model, dimensions, quantity, application, delivery country and any drawing or marking photos.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  },
  {
    step: '02',
    title: 'Specification review',
    summary:
      'We review series references, dimensions, mounting, load, speed, sealing and modification requirements.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  },
  {
    step: '03',
    title: 'Quotation & confirmation',
    summary:
      'Receive the proposed specification, price, lead time, inspection scope and delivery terms.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  },
  {
    step: '04',
    title: 'Inspection & shipment',
    summary:
      'The order is checked against confirmed requirements and prepared for international delivery.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7V10z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7" cy="17" r="2" stroke="currentColor" stroke-width="2"/><circle cx="17" cy="17" r="2" stroke="currentColor" stroke-width="2"/></svg>',
  },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDescription,
  url: pageUrl,
  primaryImageOfPage: `${site.url}/images/industrial-bearing-hero.webp`,
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
  about: {
    '@type': 'Thing',
    name: 'Industrial roller bearings and cam followers',
  },
};

const iconArrow =
  '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

const iconInspect =
  '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const iconCase =
  '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7h18v11a2 2 0 01-2 2H5a2 2 0 01-2-2V7z" stroke="currentColor" stroke-width="2"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2" stroke="currentColor" stroke-width="2"/></svg>';

const popularSeries = [
  { code: 'NUTR', name: 'Yoke type track rollers', note: 'Full-complement cylindrical rollers with axial guidance', href: '/products/track-roller-bearings/#technical-reference-heading-3' },
  { code: 'NNTR / RSU', name: 'Support rollers', note: 'Double-row heavy support roller references', href: '/products/track-roller-bearings/#technical-reference-heading-1' },
  { code: 'NUKR', name: 'Stud type track rollers', note: 'Stud-mounted rollers with published dimensions and loads', href: '/products/track-roller-bearings/#technical-reference-heading-2' },
  { code: 'NATR..-PP', name: 'Track roller reference', note: '13 verified model rows with dimensions and ratings', href: '/products/track-roller-bearings/#technical-reference-heading-0' },
  { code: 'SL18 30', name: 'Full-complement bearings', note: 'High radial capacity single-row series samples', href: '/products/full-complement-cylindrical-roller-bearings/#technical-reference-heading-0' },
  { code: '4.058', name: 'Combined bearings', note: 'Radial and axial bearing reference for steel profiles', href: '/products/combined-bearings/#technical-reference-heading-0' },
  { code: 'RB / CRB', name: 'Cross roller bearings', note: 'High rigidity slewing and rotation references', href: '/products/cross-roller-bearings/' },
  { code: 'PR', name: 'Back-up rollers', note: 'Heavy radial support rollers for metal forming', href: '/products/backup-roller-bearings/' },
];

const technicalHighlights = [
  { eyebrow: 'Track roller data', title: 'NATR..-PP dimensions and loads', metric: '13 verified model rows', text: 'Compare d, D, B, radial load ratings, grease speed and mass using processed primary-source data.', href: '/products/track-roller-bearings/#technical-reference-heading-0', linkLabel: 'View NATR technical table', downloadHref: '/downloads/natr-pp-track-roller-reference.pdf' },
  { eyebrow: 'Stud roller data', title: 'NUKR published specifications', metric: '8 model references', text: 'Review outside diameter, stud size, overall length, thread, radial ratings, speed and mass.', href: '/products/track-roller-bearings/#technical-reference-heading-2', linkLabel: 'View NUKR parameters', downloadHref: '/downloads/nukr-stud-track-roller-reference.pdf' },
  { eyebrow: 'Combined bearing data', title: 'Combined bearing series catalog', metric: 'Standard + eccentric + jumbo', text: 'Download factory dimensions and JD / MR / TR cross-references, then confirm the controlled drawing before order.', href: '/products/combined-bearings/', linkLabel: 'Browse combined bearings', downloadHref: '/downloads/combined-bearing-standard-series-reference.pdf' },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  currentPath="/"
  image="/images/industrial-bearing-hero.webp"
  jsonLd={[
    webPageSchema,
    itemListSchema(
      products.map((product) => ({
        name: product.title,
        url: `${site.url}/products/${product.slug}/`,
      })),
    ),
    faqSchema(productFaqs.map((faq) => ({ question: faq.question, answer: faq.answer }))),
  ]}
>
  <div class="home-page products-page">
    <div class="section-gap bottom">
      <div class="container">
        <section class="home-hero fade-in" aria-labelledby="home-hero-heading">
          <div class="home-hero-shell">
            <div class="home-hero-copy">
              <div class="home-hero-copy-main">
                <p class="home-hero-kicker">{site.tagline}</p>
                <h1 class="home-hero-title" id="home-hero-heading">
                  China Industrial Bearing Manufacturer
                  <span>Factory-direct OEM, replacement &amp; custom</span>
                </h1>
                <div class="home-hero-accent" aria-hidden="true"></div>
                <p class="home-hero-summary">
                  We manufacture combined bearings, track rollers, SL full-complement cylindrical roller bearings,
                  back-up rollers and cross roller bearings at our Changzhou plant. Send the model, dimensions,
                  drawing, quantity and operating conditions for a factory quotation.
                </p>
              </div>

              <div class="home-hero-copy-foot">
                <div class="home-hero-actions">
                  <a href="/contact/?source=homepage" class="products-btn products-btn-primary home-hero-btn">
                    Request factory quote
                    <span set:html={iconArrow} />
                  </a>
                  <a href="/products/" class="products-btn products-btn-secondary home-hero-btn">
                    Browse products
                  </a>
                </div>
                <ul class="home-trust-row">
                  <li>Changzhou manufacturing base</li>
                  <li>Standard &amp; drawing-based production</li>
                  <li>Shanghai export packing</li>
                </ul>
              </div>
            </div>

            <div class="home-hero-media">
              <div class="home-hero-frame">
                <div class="home-hero-image-wrap">
                  <img
                    src="/images/industrial-bearing-hero.webp"
                    alt="Industrial combined bearings, track rollers and roller bearings"
                    width="800"
                    height="640"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  />
                  <div class="home-hero-image-overlay" aria-hidden="true"></div>
                  <span class="home-hero-chip">{products.length} bearing families</span>
                  <span class="home-hero-badge">Factory production</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="home-section" aria-labelledby="home-series-heading">
          <div class="home-band home-band--series home-section-inner fade-in">
            <CatalogSectionHead
              kicker="Find by Series"
              title="Popular bearing series and replacement references"
              titleId="home-series-heading"
              align="split"
            >
              Start with the designation family, then verify every suffix, dimension and operating condition before ordering.
            </CatalogSectionHead>
            <div class="home-series-grid">
              {popularSeries.map((item) => (
                <a class="home-series-card" href={item.href}>
                  <span class="home-series-code">{item.code}</span>
                  <strong>{item.name}</strong>
                  <span>{item.note}</span>
                  <span class="home-series-action">Open series <span set:html={iconArrow} /></span>
                </a>
              ))}
            </div>
            <p class="home-series-footnote">
              Model numbers identify a starting point, not automatic interchangeability. For additional references, browse the
              <a href="/products/"> complete product catalog</a> or
              <a href="/resources/"> technical guides</a>.
            </p>
          </div>
        </section>

        <section class="home-section" aria-labelledby="home-products-heading">
          <div class="home-band home-band--products home-section-inner fade-in">
            <CatalogSectionHead
              kicker="Product Catalog"
              title="Industrial bearing products"
              titleId="home-products-heading"
              align="split"
            >
              Search by family or series, then send the operating data for confirmation before
              ordering standard or drawing-based options.
            </CatalogSectionHead>

            <div class="products-grid">
              {products.map((product) => (
                <article class="products-card">
                  <a href={`/products/${product.slug}/`} class="products-card-media">
                    <img
                      src={product.image}
                      alt={`${product.title} product range and reference models`}
                      width="400"
                      height="310"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="products-card-media-label">View specifications</span>
                  </a>
                  <div class="products-card-body">
                    <h3>
                      <a href={`/products/${product.slug}/`}>{product.title}</a>
                    </h3>
                    <p>{product.summary}</p>
                    <a href={`/products/${product.slug}/`} class="products-text-link">
                      Models and specifications
                      <span set:html={iconArrow} />
                    </a>
                  </div>
                </article>
              ))}
            </div>

            <p class="home-footer-links">
              <a href="/products/">View full product catalog</a>
              <span aria-hidden="true">·</span>
              <a href="/resources/">Technical guides</a>
            </p>
          </div>
        </section>

        <section class="home-section" aria-labelledby="home-technical-heading">
          <div class="home-band home-band--technical home-section-inner fade-in">
            <CatalogSectionHead
              kicker="Verified Technical References"
              title="Dimensions, load data and downloadable selection material"
              titleId="home-technical-heading"
              align="split"
            >
              Public data is processed for initial identification and linked to its source notes. Final selection still requires the quoted factory drawing.
            </CatalogSectionHead>
            <div class="home-technical-grid">
              {technicalHighlights.map((item) => (
                <article class="home-technical-card">
                  <p class="home-technical-eyebrow">{item.eyebrow}</p>
                  <h3>{item.title}</h3>
                  <strong class="home-technical-metric">{item.metric}</strong>
                  <p>{item.text}</p>
                  <div class="home-technical-actions">
                    <a href={item.href}>{item.linkLabel}<span set:html={iconArrow} /></a>
                    {item.downloadHref && <a class="home-technical-download" href={item.downloadHref} download>Download PDF</a>}
                  </div>
                </article>
              ))}
            </div>
            <p class="home-evidence-note">
              Technical values are reference data, not a blanket interchange guarantee. Review the model suffix, permissible outer-ring load, mounting, lubrication, track condition and current controlled drawing.
            </p>
          </div>
        </section>

        <section class="home-section" aria-labelledby="home-process-heading">
          <div class="home-band home-section-inner fade-in">
            <CatalogSectionHead
              kicker="How It Works"
              title="From model to delivery"
              titleId="home-process-heading"
            />
            <div class="home-process-grid">
              {workflowSteps.map((item) => (
                <article class="home-process-card">
                  <div class="home-process-top">
                    <span class="home-process-icon" set:html={item.icon} />
                    <span class="home-process-step">{item.step}</span>
                  </div>
                  <h3 class="home-process-title">{item.title}</h3>
                  <p class="home-process-summary">{item.summary}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="home-section" aria-labelledby="home-trust-heading">
          <div class="home-band home-band--evidence home-section-inner fade-in">
            <CatalogSectionHead
              kicker="Manufacturing & Inspection"
              title="Changzhou plant capacity, inspection and application cases"
              titleId="home-trust-heading"
              align="split"
            >
              CNC machining, measurement equipment and application references from our Changzhou manufacturing base.
            </CatalogSectionHead>
            <div class="home-evidence-layout">
              <div class="home-evidence-gallery">
                {factoryFacilityMedia.slice(0, 2).map((media) => (
                  <figure>
                    <img src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy" decoding="async" />
                    <figcaption><strong>{media.title}</strong><span>{media.description}</span></figcaption>
                  </figure>
                ))}
              </div>
              <div class="home-evidence-cards">
                <article class="home-trust-card">
                  <span class="home-trust-icon" set:html={iconInspect} />
                  <h3>Factory inspection scope with every RFQ</h3>
                  <p>Dimension, marking, packing and inspection documents are defined before production release. Batch reports can be provided against the quoted product.</p>
                  <a href="/certifications/">Review factory QC scope<span set:html={iconArrow} /></a>
                </article>
                <article class="home-trust-card">
                  <span class="home-trust-icon" set:html={iconCase} />
                  <h3>OEM and steel-line application cases</h3>
                  <p>Review steel-equipment and cross-roller application references used for factory quotation and drawing confirmation.</p>
                  <a href="/case-studies/">View application cases<span set:html={iconArrow} /></a>
                </article>
              </div>
            </div>
            <p class="home-evidence-source">
              <strong>Plant evidence:</strong> <a href={factoryEvidenceSource.url}>{factoryEvidenceSource.name}</a>. {factoryEvidenceSource.disclosure}
            </p>
          </div>
        </section>

        <section class="home-section" aria-label="Request a quotation">
          <aside class="products-rfq-panel fade-in">
            <p>
              <strong>Need pricing for a specific bearing?</strong>
              Send the complete designation, d × D × B dimensions, quantity, application and
              destination for a faster quotation.
            </p>
            <div class="products-rfq-actions">
              <a href="/contact/?source=homepage-rfq" class="products-btn products-btn-primary">
                Request bearing pricing
                <span set:html={iconArrow} />
              </a>
              <a href="/resources/industrial-bearing-rfq-checklist/" class="products-btn products-btn-secondary">
                RFQ checklist
              </a>
            </div>
          </aside>
        </section>

        <section class="home-section" aria-labelledby="home-resources-heading">
          <nav class="home-band home-band--soft home-resources fade-in" aria-label="Related bearing resources">
            <h2 id="home-resources-heading">Related bearing resources</h2>
            <ul class="home-resources-links">
              <li><a href="/downloads/">Factory catalog downloads</a></li>
              <li><a href="/solutions/china-bearing-manufacturer-export/">China factory export RFQ</a></li>
              <li><a href="/solutions/bearing-export-shipping-incoterms/">Export shipping &amp; Incoterms</a></li>
              <li><a href="/solutions/oem-custom-bearing-program/">OEM custom bearing program</a></li>
              <li><a href="/solutions/winkel-bearing-cross-reference/">WINKEL cross reference</a></li>
              <li><a href="/resources/industrial-bearing-rfq-checklist/">Industrial bearing RFQ checklist</a></li>
              <li><a href="/case-studies/">Application references</a></li>
              <li><a href="/about/">About our factory</a></li>
            </ul>
          </nav>

          <p class="home-footer-links fade-in">
            <a href="/products/">All bearing products</a>
            <span aria-hidden="true">·</span>
            <a href="/contact/?source=homepage-footer">Request a quote</a>
          </p>
        </section>
      </div>
    </div>

    <div class="products-faq-wrap">
      <FaqSection
        items={productFaqs}
        title="Industrial Bearing Supply FAQ"
        subtitle="Common Buyer Questions"
      />
    </div>
  </div>
</BaseLayout>
