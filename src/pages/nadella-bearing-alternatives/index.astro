---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbHero from "../../components/BreadcrumbHero.astro";
import DetailRfqStrip from "../../components/DetailRfqStrip.astro";
import { nadellaSeries } from "../../data/nadella-alternatives";
import { breadcrumbSchema, site } from "../../data/site";
import "../../styles/resource-page.css";
import "../../styles/nadella-alternatives.css";

const totalModels = nadellaSeries.reduce(
  (total, series) => total + series.models.length,
  0,
);
---

<BaseLayout
  title="NADELLA Cam Follower Alternatives | GC, GCR, FG, FGU, PK & FK"
  description="Find replacement and equivalent options for NADELLA cam followers and guide rollers, including GC, GCR, GCU, GCUR, FG, FGU, PK, PKR, FK, FP, PFL, PFP and PFDL series."
  currentPath="/nadella-bearing-alternatives"
  jsonLd={breadcrumbSchema([
    { name: "Home", url: site.url },
    {
      name: "NADELLA Bearing Alternatives",
      url: `${site.url}/nadella-bearing-alternatives/`,
    },
  ])}
>
  <BreadcrumbHero
    title="NADELLA Cam Follower Alternatives"
    trail={[{ label: "Home", href: "/" }, { label: "NADELLA Alternatives" }]}
    variant="2"
  />

  <div class="nadella-page">
    <section class="nadella-intro" aria-labelledby="nadella-intro-title">
      <div class="container">
        <div class="nadella-intro-grid">
          <div class="nadella-intro-copy">
            <p class="nadella-eyebrow">Independent replacement sourcing</p>
            <h2 id="nadella-intro-title">Start with the series. Confirm with the application.</h2>
            <p class="nadella-lead">
              Find the original NADELLA series or model, then send the complete
              suffix and operating details. We review the mounting, dimensions,
              outer-ring profile, rolling elements, sealing and lubrication before
              recommending an alternative.
            </p>
            <div class="nadella-intro-actions">
              <a class="nadella-button nadella-button--primary" href="#series-range">
                Browse series
                <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18">
                  <path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
              <a
                class="nadella-button nadella-button--secondary"
                href="/contact/?source=nadella-alternative"
                data-rfq-modal
                data-rfq-context="NADELLA alternative cross-reference"
              >Request a cross-reference</a>
            </div>
          </div>

          <aside class="nadella-proof" aria-label="Replacement range summary">
            <div class="nadella-proof-stats">
              <div>
                <strong>{nadellaSeries.length}</strong>
                <span>series groups</span>
              </div>
              <div>
                <strong>{totalModels}+</strong>
                <span>model references</span>
              </div>
            </div>
            <ul class="nadella-proof-list">
              <li>
                <svg aria-hidden="true" viewBox="0 0 20 20"><path d="m5 10 3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                Stud, yoke and bore-mounted designs
              </li>
              <li>
                <svg aria-hidden="true" viewBox="0 0 20 20"><path d="m5 10 3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                Needle and cylindrical roller options
              </li>
              <li>
                <svg aria-hidden="true" viewBox="0 0 20 20"><path d="m5 10 3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                Dimensional review before interchange approval
              </li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <section class="nadella-series-section" id="series-range" aria-labelledby="series-title">
      <div class="container">
        <div class="nadella-section-heading">
          <div>
            <p class="nadella-eyebrow">Series directory</p>
            <h2 id="series-title">Choose the closest original series</h2>
          </div>
          <p>
            Each series page includes construction notes, mounting guidance,
            seal options and individual model links.
          </p>
        </div>

        <nav class="nadella-series-jump" aria-label="Jump to a NADELLA series">
          {nadellaSeries.map((series) => (
            <a href={`#series-${series.slug}`}>{series.code}</a>
          ))}
        </nav>

        <div class="nadella-series-grid">
          {nadellaSeries.map((series, index) => (
            <article class="nadella-series-card" id={`series-${series.slug}`}>
              <div class="nadella-series-card-top">
                <span class="nadella-series-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="nadella-series-count">{series.models.length} models</span>
              </div>
              <p class="nadella-series-code">{series.code}</p>
              <h3>
                <a href={`/nadella-bearing-alternatives/${series.slug}/`}>
                  {series.name}
                </a>
              </h3>
              <p class="nadella-series-description">{series.design}.</p>
              <dl class="nadella-series-specs">
                <div>
                  <dt>Mounting</dt>
                  <dd>{series.mounting}</dd>
                </div>
                <div>
                  <dt>Rolling elements</dt>
                  <dd>{series.rollingElements}</dd>
                </div>
              </dl>
              <a
                href={`/nadella-bearing-alternatives/${series.slug}/`}
                class="nadella-series-link"
                aria-label={`View ${series.code} models and replacement guidance`}
              >
                View models and guidance
                <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18">
                  <path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="nadella-process" aria-labelledby="nadella-process-title">
      <div class="container">
        <div class="nadella-section-heading nadella-section-heading--light">
          <div>
            <p class="nadella-eyebrow">Replacement workflow</p>
            <h2 id="nadella-process-title">Three checks before a replacement is confirmed</h2>
          </div>
          <p>A model number is the starting point—not the final interchange decision.</p>
        </div>
        <ol class="nadella-process-grid">
          <li>
            <span>01</span>
            <h3>Identify the full reference</h3>
            <p>Include every prefix and suffix, plus a clear photo of the marking or the original drawing.</p>
          </li>
          <li>
            <span>02</span>
            <h3>Confirm the critical geometry</h3>
            <p>Measure outside diameter, bore or stud thread, width, shoulder details and outer-ring profile.</p>
          </li>
          <li>
            <span>03</span>
            <h3>Review the operating duty</h3>
            <p>Share load, speed, shock, temperature, lubrication, quantity and the required destination.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="nadella-checklist" aria-labelledby="nadella-checklist-title">
      <div class="container">
        <div class="nadella-checklist-panel">
          <div>
            <p class="nadella-eyebrow">Prepare your inquiry</p>
            <h2 id="nadella-checklist-title">Send enough detail for a useful first review</h2>
            <p>
              The fastest requests include the original model, suffix, measured
              dimensions, quantity, application and destination. If the marking
              is incomplete, attach a drawing or several clear photos.
            </p>
          </div>
          <ul>
            <li>Complete model and suffix</li>
            <li>Outside diameter and width</li>
            <li>Bore size or stud thread</li>
            <li>Convex or cylindrical outer ring</li>
            <li>Seal and lubrication requirement</li>
            <li>Load, speed and operating environment</li>
          </ul>
        </div>
        <p class="nadella-trademark-notice">
          <strong>Independent supplier notice:</strong> NADELLA is a trademark of
          its respective owner. Precision Bearing Source is an independent supplier
          and is not affiliated with or endorsed by NADELLA. Brand and model
          references are used only for product identification and replacement research.
        </p>
      </div>
    </section>
  </div>

  <DetailRfqStrip
    title="Need a NADELLA model cross-reference?"
    text="Send the full model, suffix, dimensions, quantity, application and destination for replacement review."
    label="Request an Alternative"
    quoteHref="/contact/?source=nadella-alternative"
    secondaryLabel="All Bearing Products"
    secondaryHref="/products/"
  />
</BaseLayout>
