---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BreadcrumbHero from "../../../components/BreadcrumbHero.astro";
import DetailRfqStrip from "../../../components/DetailRfqStrip.astro";
import {
  nadellaModelPages,
  modelNumber,
} from "../../../data/nadella-alternatives";
import {
  breadcrumbSchema,
  faqSchema,
  productSchema,
  site,
} from "../../../data/site";
import "../../../styles/resource-page.css";
import "../../../styles/nadella-detail.css";
export function getStaticPaths() {
  return nadellaModelPages.map((item) => ({
    params: { model: item.slug },
    props: { item },
  }));
}
const { item } = Astro.props;
const { series, model } = item;
const pageUrl = `${site.url}/nadella-bearing-alternatives/model/${item.slug}/`;
const numbers = modelNumber(model);
const faqs = [
  {
    question: `What is the replacement for NADELLA ${model}?`,
    answer: `The correct alternative must be selected after checking the complete ${model} designation, dimensions, ${series.mounting}, outer-ring profile, sealing and operating conditions.`,
  },
  {
    question: `Can I order a ${model} equivalent by model number only?`,
    answer:
      "The model is a useful starting point, but a drawing or measured dimensions and the complete suffix are recommended before ordering.",
  },
  {
    question: "Is this an original NADELLA bearing?",
    answer:
      "No. This page covers independently manufactured replacement options. NADELLA model references are used only for identification.",
  },
];
---

<BaseLayout
  title={`NADELLA ${model} Alternative | Cam Follower Replacement`}
  description={`Source an alternative to NADELLA ${model}. Check ${series.code} dimensions, mounting, outer-ring profile, seals, application data and replacement availability.`}
  currentPath="/nadella-bearing-alternatives"
  image="/images/industrial-bearing-product-range.webp"
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", url: site.url },
      {
        name: "NADELLA Alternatives",
        url: `${site.url}/nadella-bearing-alternatives/`,
      },
      {
        name: `${series.code} Series`,
        url: `${site.url}/nadella-bearing-alternatives/${series.slug}/`,
      },
      { name: `${model} Alternative`, url: pageUrl },
    ]),
    productSchema({
      name: `${model} Alternative Cam Follower`,
      description: `Independent replacement option for ${model}, subject to dimensional and application confirmation.`,
      url: pageUrl,
      image: `${site.url}/images/industrial-bearing-product-range.webp`,
      model: `Alternative for ${model}`,
      category: "Cam Followers",
    }),
    faqSchema(faqs),
  ]}
>
  <BreadcrumbHero
    title={`${model} Alternative Cam Follower`}
    trail={[
      { label: "Home", href: "/" },
      { label: "NADELLA Alternatives", href: "/nadella-bearing-alternatives/" },
      {
        label: series.code,
        href: `/nadella-bearing-alternatives/${series.slug}/`,
      },
      { label: model },
    ]}
    variant="3"
  />
  <section class="resource-page-section nadella-detail-page nadella-model-page">
    <div class="section-gap">
      <div class="container">
        <div class="resource-page-intro">
          <p class="resource-page-kicker">
            {series.code} model cross-reference
          </p><h2>NADELLA {model} Alternative and Replacement</h2><p>
            Looking for a replacement for <strong>{model}</strong>? We review
            independently manufactured alternatives against the original
            designation, physical dimensions and real operating conditions
            before confirming suitability.
          </p>
          <dl class="nadella-detail-facts">
            <div><dt>Requested model</dt><dd>{model}</dd></div>
            <div><dt>Series family</dt><dd>{series.code}</dd></div>
            <div><dt>Reference numbers</dt><dd>{numbers || "Confirm from drawing"}</dd></div>
          </dl>
        </div><div class="resource-page-content">
          <h2>{model} Replacement Overview</h2><p>
            {model} belongs to the {series.code}
            {series.name.toLowerCase()} group. Its reference numbers are {
              numbers
            }; these numbers are identifiers only and must not be treated as a
            complete dimensional specification without a drawing or measurement
            check.
          </p><h2>Construction Details to Confirm</h2><h3>Follower design</h3><p
          >
            {series.design}. The replacement must reproduce the required running
            surface and internal rolling-element arrangement: {
              series.rollingElements
            }.
          </p><h3>Mounting</h3><p>
            The series uses {series.mounting}. Confirm all bore, stud, thread,
            width, abutment and locking dimensions before installation.
          </p><h3>Seals and suffixes</h3><p>
            {series.seals}. Include suffixes such as EE, EEM, MM, AK or NX when
            shown on the old bearing or purchase record.
          </p><h2>Information Needed to Quote {model}</h2><ul>
            <li>Complete model and suffix from the old bearing</li><li>
              Outside diameter, width, bore or stud/thread dimensions
            </li><li>Convex or cylindrical outer running surface</li><li>
              Quantity and annual demand
            </li><li>
              Radial load, speed, shock, temperature and lubrication
            </li><li>
              Machine application, destination and required delivery date
            </li>
          </ul><h2>Applications</h2><p>
            This series is commonly evaluated for {
              series.applications.join(", ")
            }. The actual machine conditions determine whether a standard
            cross-reference or custom follower is appropriate.
          </p><h2>{model} Alternative FAQ</h2>{
            faqs.map((item) => (
              <div class="nadella-faq-item">
                <>
                  <h3>{item.question}</h3>
                  <p>{item.answer}</p>
                </>
              </div>
            ))
          }<h2>Trademark and Interchangeability Notice</h2><p>
            NADELLA is a trademark of its respective owner. Precision Bearing
            Source is independent and not affiliated with NADELLA. This page
            does not claim automatic interchangeability; approval requires
            technical confirmation.
          </p>
        </div>
      </div>
    </div>
  </section>
  <DetailRfqStrip
    title={`Request a ${model} alternative`}
    text="Send the complete suffix, dimensions, drawing, quantity, application and destination."
    label="Get Replacement Pricing"
    quoteHref={`/contact/?source=${item.slug}`}
    secondaryLabel={`${series.code} Series Alternatives`}
    secondaryHref={`/nadella-bearing-alternatives/${series.slug}/`}
  />
</BaseLayout>
