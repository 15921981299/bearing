---
import BearingModelPage from '../../../components/BearingModelPage.astro';
import { backupRollerModels, type ExtendedBearingModel } from '../../../data/extended-bearing-models';
export function getStaticPaths() {
  return backupRollerModels.map((item) => ({ params: { model: item.slug }, props: { item } }));
}
const { item } = Astro.props as { item: ExtendedBearingModel };
---
<BearingModelPage item={item} />
