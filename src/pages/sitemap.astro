---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbHero from '../components/BreadcrumbHero.astro';
import { products } from '../data/products';
import { technicalResources } from '../data/resources';
import { factoryCaseStudies } from '../data/factory-evidence';
import { combinedBearingModels } from '../data/combined-bearing-models';
import { backupRollerModels, crossRollerModels, fullComplementModels, nbvProfileModels, specialTrackRollerModels, trackRollerModels } from '../data/extended-bearing-models';
import { seoLandingPages } from '../data/seo-landing-pages';
import { specialCombinedSeries } from '../data/special-combined-series';
---
<BaseLayout title="Sitemap" description="Browse industrial bearing products, technical guides and application references." currentPath="/sitemap"><BreadcrumbHero title="Sitemap" trail={[{label:'Home',href:'/'},{label:'Sitemap'}]} variant="5"/><section class="blog-details-section resource-page-section"><div class="section-gap bottom"><div class="container"><article class="blog-details-content-block resource-page"><h2>Main Pages</h2><ul><li><a href="/">Home</a></li><li><a href="/products/">Bearing Products</a></li><li><a href="/solutions/">Combined Bearing Solutions</a></li><li><a href="/downloads/">Downloads</a></li><li><a href="/resources/">Technical Guides</a></li><li><a href="/case-studies/">Application References</a></li><li><a href="/about/">About</a></li><li><a href="/certifications/">Quality</a></li><li><a href="/contact/">Contact</a></li></ul><h2>Bearing Products</h2><ul>{products.map(p=><li><a href={`/products/${p.slug}/`}>{p.title}</a></li>)}</ul><h2>Combined Bearing Models</h2><ul>{combinedBearingModels.map(model=><li><a href={`/products/combined-bearings/${model.slug}/`}>{model.model} Combined Bearing</a></li>)}</ul><h2>Special Combined Bearing Series</h2><ul>{specialCombinedSeries.map(item=><li><a href={`/products/combined-bearing-series/${item.slug}/`}>{item.title}</a></li>)}</ul><h2>Track Roller Models</h2><ul>{trackRollerModels.map(model=><li><a href={`/products/track-roller-bearings/${model.slug}/`}>{model.model}</a></li>)}</ul><h2>Back-up Roller Models</h2><ul>{backupRollerModels.map(model=><li><a href={`/products/backup-roller-bearings/${model.slug}/`}>{model.model}</a></li>)}</ul><h2>Special Track Roller Models</h2><ul>{specialTrackRollerModels.map(model=><li><a href={`/products/special-track-roller-bearings/${model.slug}/`}>{model.model}</a></li>)}</ul><h2>Full Complement Bearing Models</h2><ul>{fullComplementModels.map(model=><li><a href={`/products/full-complement-cylindrical-roller-bearings/${model.slug}/`}>{model.model}</a></li>)}</ul><h2>Cross Roller Models</h2><ul>{crossRollerModels.map(model=><li><a href={`/products/cross-roller-bearings/${model.slug}/`}>{model.model}</a></li>)}</ul><h2>Standard NbV Profiles</h2><ul>{nbvProfileModels.map(model=><li><a href={`/products/standard-nbv-profiles/${model.slug}/`}>{model.model}</a></li>)}</ul><h2>Solutions and Applications</h2><ul>{seoLandingPages.map(item=><li><a href={`/solutions/${item.slug}/`}>{item.title}</a></li>)}</ul><h2>Technical Guides</h2><ul>{technicalResources.map(resource=><li><a href={`/resources/${resource.slug}/`}>{resource.title}</a></li>)}</ul><h2>Application References</h2><ul>{factoryCaseStudies.map(study=><li><a href={`/case-studies/${study.slug}/`}>{study.title}</a></li>)}</ul></article></div></div></section></BaseLayout>
