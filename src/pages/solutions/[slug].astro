---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import DetailRfqStrip from '../../components/DetailRfqStrip.astro';
import { seoLandingPages, type SeoLandingPage } from '../../data/seo-landing-pages';
import { breadcrumbSchema, faqSchema, serviceSchema, site } from '../../data/site';
import '../../styles/product-model.css';

export function getStaticPaths() {
  return seoLandingPages.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props as { item: SeoLandingPage };
const pageUrl = `${site.url}/solutions/${item.slug}/`;
---

<BaseLayout title={item.seoTitle} description={item.description} currentPath="/solutions" jsonLd={[
  breadcrumbSchema([{name:'Home',url:site.url},{name:'Solutions',url:`${site.url}/solutions/`},{name:item.title,url:pageUrl}]),
  serviceSchema({name:item.title,description:item.description,url:pageUrl,image:`${site.url}/images/industrial-bearing-product-range.webp`}),
  faqSchema(item.faqs),
]}>
  <BreadcrumbHero title={item.title} trail={[{label:'Home',href:'/'},{label:'Solutions',href:'/solutions/'},{label:item.title}]} variant="2" />
  <main class="model-page">
    <section class="model-page-section">
      <div class="section-gap bottom">
        <div class="container">
          <article class="model-shell">
            <header class="model-intro">
              <p class="model-kicker">{item.cluster}</p>
              <h2 class="model-title">Selection, replacement and quotation support</h2>
              <p class="model-lead">{item.intro}</p>
              <div class="model-actions">
                <a href={`/contact/?source=solution-${item.slug}`} class="products-btn products-btn-primary" data-rfq-modal data-rfq-context={`${item.title} inquiry`} data-rfq-source={`solution-${item.slug}`}>Request technical review</a>
                <a href="/products/combined-bearings/" class="products-btn products-btn-secondary">Browse combined bearings</a>
              </div>
            </header>

            <p class="model-note">
              Cross references and catalog data support preliminary identification. Confirm the current drawing, load
              capacity, tolerances and application requirements before ordering.
            </p>

            <div class="model-content-grid">
              {item.sections.map((section) => (
                <section>
                  <h2>{section.heading}</h2>
                  <p>{section.body}</p>
                  <ul class="model-aliases">
                    {section.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                </section>
              ))}
            </div>

            <section class="model-section" aria-labelledby="next-steps-heading">
              <h2 id="next-steps-heading">Recommended next steps</h2>
              <ul class="model-checklist">
                <li><strong>Identify</strong> — model, suffix and machine reference</li>
                <li><strong>Measure</strong> — envelope and mounting dimensions</li>
                <li><strong>Describe duty</strong> — load, speed, shock and environment</li>
                <li><strong>Approve</strong> — proposed drawing and documents</li>
              </ul>
            </section>

            <section class="model-section" aria-labelledby="related-heading">
              <h2 id="related-heading">Related products and buyer resources</h2>
              <div class="model-related-grid">
                {item.related.map((link) => (
                  <a href={link.href}>
                    <strong>{link.label}</strong>
                    <span>View technical information</span>
                  </a>
                ))}
              </div>
            </section>

            <section class="model-section model-faq" aria-labelledby="faq-heading">
              <h2 id="faq-heading">{item.title} FAQ</h2>
              <div class="model-faq-list">
                {item.faqs.map((faq) => (
                  <details>
                    <summary>{faq.question}</summary>
                    <p>{faq.answer}</p>
                  </details>
                ))}
              </div>
            </section>
          </article>
        </div>
      </div>
    </section>
  </main>
  <DetailRfqStrip title={`Need help with ${item.title.toLowerCase()}?`} text="Send the model, drawing, quantity, application and delivery country for replacement review and quotation." label="Submit bearing details" quoteHref={`/contact/?source=solution-${item.slug}`} secondaryLabel="RFQ checklist" secondaryHref="/resources/industrial-bearing-rfq-checklist/" />
</BaseLayout>
