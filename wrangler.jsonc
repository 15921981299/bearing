{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bearing",
  "compatibility_date": "2026-07-23",
  "main": "cloudflare-worker.js",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ZOHO_SMTP_USER": "sales@combinedbearingsource.com",
    "ZOHO_SMTP_HOST": "smtppro.zoho.com",
    "ZOHO_SMTP_PORT": "465"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "bearing-rfq-uploads"
    }
  ],
  "observability": {
    "enabled": true
  }
}
