{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bearing",
  "compatibility_date": "2026-07-23",
  "main": "cloudflare-worker.js",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
